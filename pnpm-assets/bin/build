#!/usr/bin/env bash
set -euo pipefail

layers=$(cd "$1" && pwd)
node --input-type=commonjs -e '
  const pkg = require("./package.json");
  if (!pkg.packageManager?.startsWith("pnpm@")) throw new Error("Set packageManager to an exact pnpm version");
'

tool_layer="$layers/corepack"
cache_layer="$layers/store"
node_version=$(node --version)
cache_key="corepack@0.35.0 $node_version $(uname -m)"
if [[ ! -f "$tool_layer/version" ]] || [[ "$(cat "$tool_layer/version")" != "$cache_key" ]]; then
  rm -rf "$tool_layer"
  mkdir -p "$tool_layer"
  npm install --prefix "$tool_layer" --no-audit --no-fund corepack@0.35.0
  printf '%s\n' "$cache_key" > "$tool_layer/version"
fi
mkdir -p "$cache_layer"
cat > "$tool_layer.toml" <<'LAYER'
[types]
build = true
cache = true
launch = false
LAYER
cat > "$cache_layer.toml" <<'LAYER'
[types]
build = false
cache = true
launch = false
LAYER

export PATH="$tool_layer/node_modules/.bin:$PATH"
export COREPACK_HOME="$tool_layer/home"
export CI=true
corepack pnpm install --store-dir "$cache_layer" --frozen-lockfile --prod=false
corepack pnpm run "${BP_PNPM_BUILD_SCRIPT:-build}"

# Only generated assets are needed by the subsequent Go build.
find . -name node_modules -prune -exec rm -rf {} +
